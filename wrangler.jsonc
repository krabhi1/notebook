{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webbook",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server/entry-worker.ts",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notebook",
      "database_id": "e836e2e7-eab0-444e-af8b-51c86bf42969",
    },
  ],
}
